{
  "name": "teamhub-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc --noEmit --skipLibCheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:rls": "vitest run --config vitest.config.rls.ts --env-file .env.test",
    "test:e2e": "playwright test",
    "generate-types": "npx supabase gen types typescript --local > src/lib/database.types.ts",
    "generate-types:remote": "npx supabase gen types typescript --project-id njdeuehessdffwmmzmcs > src/lib/database.types.ts",
    "db:dump-schema": "node scripts/dump-schema.mjs",
    "db:migration-table": "node scripts/migration-table-info.mjs",
    "db:copy-baseline": "node scripts/copy-baseline.mjs",
    "db:organize-baseline": "node scripts/organize-baseline.mjs",
    "db:mark-baseline-applied": "node scripts/mark-baseline-applied.mjs",
    "db:verify-baseline": "node scripts/verify-baseline-fresh.mjs",
    "db:archive-legacy": "node scripts/archive-legacy-migrations.mjs",
    "db:prepare-baseline": "npm run db:copy-baseline && npm run db:organize-baseline",
    "generate:feature-keys": "npx tsx scripts/generate-feature-keys.ts",
    "emails:watch": "mjml -w emails/mjml -o emails/compiled",
    "emails:build": "mjml emails/mjml/admin-invite.mjml emails/mjml/announcement.mjml emails/mjml/follow-up-message.mjml emails/mjml/guardian-invite.mjml emails/mjml/marketing-promo.mjml emails/mjml/member-referral.mjml emails/mjml/new_event.mjml emails/mjml/new_message.mjml emails/mjml/newsletter.mjml emails/mjml/organizer-outreach.mjml emails/mjml/partner-invite.mjml emails/mjml/password-reset.mjml emails/mjml/payment_receipt.mjml emails/mjml/ticket-receipt.mjml emails/mjml/photo-approved.mjml emails/mjml/photo-rejected.mjml emails/mjml/program-highlights.mjml emails/mjml/re-engagement.mjml emails/mjml/staff-invite.mjml emails/mjml/urgent-notification.mjml -o emails/compiled"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mux/mux-node": "^12.8.1",
    "@mux/upchunk": "^3.5.0",
    "@react-google-maps/api": "^2.19.4",
    "@stripe/stripe-js": "^4.8.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/papaparse": "^5.5.2",
    "colord": "^2.9.3",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "papaparse": "^5.5.3",
    "pg": "^8.17.1",
    "postgres": "^3.4.8",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.14.0",
    "react-dom": "^18.3.1",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.6.0",
    "react-photo-album": "^3.4.0",
    "react-remove-scroll": "^2.7.2",
    "react-router-dom": "^7.1.1",
    "resend": "^4.0.0",
    "stream-chat": "^8.0.0",
    "stream-chat-react": "^11.0.0",
    "stripe": "^17.5.0",
    "supabase": "^2.76.6",
    "xlsx": "^0.18.5",
    "yet-another-react-lightbox": "^3.28.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^28.0.0",
    "mjml": "^4.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
