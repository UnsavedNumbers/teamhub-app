# Screenshot System Configuration
# Copy this file to .env and fill in values

# Required: Base URL of the demo site
YS_BASE_URL=http://localhost:5173

# Required: Environment label (used in output paths)
YS_ENV_LABEL=demo

# Optional: Output directory (default: artifacts/screenshots)
YS_OUTPUT_DIR=artifacts/screenshots

# Optional: Roles to screenshot (comma-separated, default: org_admin,guardian)
# Valid roles: org_admin, coach, parent, athlete, staff, fan
YS_ROLES=org_admin,guardian

# Optional: Viewports to capture (comma-separated, default: desktop,mobile)
# Valid viewports: desktop, tablet, mobile
YS_VIEWPORTS=desktop,mobile

# Required for demo_code auth: Demo code
YS_DEMO_CODE=VPP5GN83RTCR

# Optional: Auth strategy (demo_code or storage_state, default: demo_code)
YS_AUTH_STRATEGY=demo_code

# Optional: Storage state directory (only needed if YS_AUTH_STRATEGY=storage_state)
# Storage states are saved to playwright/.auth/<env>/<role>.json by default
YS_STORAGE_STATE_DIR=playwright/.auth

# Optional: Wait strategy (selector or networkidle, default: selector)
YS_WAIT_STRATEGY=selector
