VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Places API Key (client-side for autocomplete)
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
# IMPORTANT: Configure API key restrictions in Google Cloud Console:
#   1. HTTP referrer restrictions: Add your production domain and localhost for development
#      Example: https://yourdomain.com/* and http://localhost:*/*
#   2. API restrictions: Enable only "Places API" (not Maps JavaScript API)
#   3. Do NOT use IP restrictions (this is for client-side usage)
VITE_GOOGLE_PLACES_API_KEY=

# Google Places API Key (server-side for Edge Functions)
# This key is used server-side only and should have different restrictions:
#   1. IP restrictions: Add Supabase Edge Function IPs (if available)
#   2. API restrictions: Enable "Places API (New)" only
#   3. Store this in Supabase Edge Function secrets, not in .env
# GOOGLE_PLACES_API_KEY=

# Google Gemini API Key (server-side for AI summaries)
# Get your API key from: https://makersuite.google.com/app/apikey
# IMPORTANT: Configure API key restrictions in Google Cloud Console:
#   1. IP restrictions: Add Supabase Edge Function IPs (if available)
#   2. API restrictions: Enable "Generative Language API" only
#   3. Store this in Supabase Edge Function secrets, not in .env
# GOOGLE_GEMINI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_STANDARD_YEAR=
STRIPE_PRICE_PRO_YEAR=

STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
