<mjml>
  <mj-head>
    <mj-title>New Event: {{event_title}}</mj-title>
    <mj-preview>A new event has been scheduled for your team</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
      .footer-text {
        color: #64748b !important;
        font-size: 12px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-include path="partials/header.mjml" />

    <mj-section padding="40px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          New Event: {{event_title}}
        </mj-text>
        <mj-text padding-bottom="16px">
          Hi {{recipient_name}},
        </mj-text>
        <mj-text padding-bottom="24px">
          A new event has been scheduled for your team:
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px" background-color="#ffffff" border-radius="8px" border="1px solid #e2e8f0">
      <mj-column>
        <mj-text font-size="16px" font-weight="bold" color="#1e293b" padding-bottom="12px">
          {{event_title}}
        </mj-text>
        <mj-text padding-bottom="8px">
          📅 {{event_date}}<br>
          🕐 {{event_time}}<br>
          📍 {{event_location}}
        </mj-text>
        {{#if event_description}}
        <mj-text padding-top="12px">
          {{event_description}}
        </mj-text>
        {{/if}}
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px">
      <mj-column>
        <mj-text padding-bottom="24px">
          {{#if is_required}}
          This is a required event. Please make sure to attend.
          {{else}}
          This is an optional event.
          {{/if}}
        </mj-text>
        <mj-button css-class="button" href="{{url}}" padding="16px 24px">
          View Event
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px">
      <mj-column>
        <mj-text>
          Questions? Contact your coach or team administrator.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
