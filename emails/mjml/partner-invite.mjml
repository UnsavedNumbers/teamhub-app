<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
      .footer-text {
        color: #64748b !important;
        font-size: 12px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-include path="partials/header.mjml" />

    <mj-section padding="40px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          Hi {{recipient_firstname}},
        </mj-text>
        <mj-text padding-bottom="16px">
          We're launching a new partner program at {{organization_name}} and we'd love for you to join us!
        </mj-text>
        <mj-text padding-bottom="16px">
          {{custom_message_paragraph_1}}
        </mj-text>
        <mj-text padding-bottom="24px">
          {{custom_message_paragraph_2}}
        </mj-text>
        {{#if video_thumbnail_url}}
        <mj-image src="{{video_thumbnail_url}}" href="{{video_url}}" width="500px" alt="Watch Video" padding-bottom="24px" />
        {{/if}}
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
