<mjml>
  <mj-head>
    <mj-title>Admin Invitation</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
     <!-- Header Image -->
    <mj-section padding="20px">
        <mj-column>
            <mj-image src="{{header_image_url}}" width="600px" alt="Admin Invite" />
        </mj-column>
    </mj-section>

     <!-- Split Content -->
    <mj-section padding="20px">
        <mj-column width="30%">
            <mj-image src="{{sender_image_url}}" width="150px" border-radius="50%" alt="Sender" />
        </mj-column>
        <mj-column width="70%">
             <mj-text font-size="16px" font-weight="bold" padding-bottom="15px">
               Hello {{recipient_firstname}},
            </mj-text>
            <mj-text padding-bottom="15px">
               {{sender_name}} ({{sender_email}}) has invited you to become an Administrator for {{organization_name}}.
            </mj-text>
            <mj-text padding-bottom="15px">
               Admins have full access to configure the organization, manage payments, and oversee all teams.
            </mj-text>
            <mj-text padding-bottom="15px">
               <a href="{{join_url}}" style="color: #2563eb; font-weight: bold;">Click here to accept the invitation</a>.
            </mj-text>
             <mj-text>
                Best,<br>
                The {{organization_name}} Team
            </mj-text>
        </mj-column>
    </mj-section>
    
    <!-- Video/Info -->
    <mj-section padding="20px">
        <mj-column>
            <mj-image src="{{info_image_url}}" width="500px" alt="Dashboard Preview" />
        </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px" background-color="#1e293b">
        <mj-column>
            <mj-text align="center" color="#ffffff" font-size="14px">
                YouthSports Team Hub
            </mj-text>
        </mj-column>
    </mj-section>
  </mj-body>
</mjml>
