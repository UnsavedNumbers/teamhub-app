<mjml>
  <mj-head>
    <mj-title>{{sender_firstname}} sent you a referral!</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
      .footer-text {
        color: #64748b !important;
        font-size: 12px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-include path="partials/header.mjml" />

    <mj-section padding="40px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          Hey {{recipient_firstname}}!
        </mj-text>
        <mj-text padding-bottom="16px">
          {{sender_name}} thinks you should check out {{organization_name}}!
        </mj-text>
        <mj-text padding-bottom="16px">
          We connect local athletes with the best coaching and facilities in the area. {{sender_name}} is already a member and wants you to join the team.
        </mj-text>
        <mj-text padding-bottom="24px">
          <a href="{{referral_url}}">Check it out here</a> to see available programs and get a special welcome offer.
        </mj-text>
        <mj-button css-class="button" href="{{referral_url}}" padding="16px 24px">
          Check it out
        </mj-button>
        <mj-text padding-top="24px">
          Cheers,<br>
          {{sender_firstname}}
        </mj-text>
      </mj-column>
    </mj-section>

    {{#if promo_image_url}}
    <mj-section padding="24px 20px">
      <mj-column>
        <mj-image src="{{promo_image_url}}" width="500px" alt="Promo" />
      </mj-column>
    </mj-section>
    {{/if}}

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
