<mjml>
  <mj-head>
    <mj-title>Reset Your Password</mj-title>
    <mj-preview>Instructions to reset your YouthSports password</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <!-- Header -->
    <mj-section padding="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#1e293b">
          {{organization_name}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content -->
    <mj-section padding="40px 20px" border-radius="8px">
      <mj-column width="100%">
        <mj-text font-size="24px" font-weight="bold" color="#1e293b" padding-bottom="20px">
          Reset Your Password
        </mj-text>
        <mj-text font-size="16px" color="#475569" padding-bottom="30px">
          We received a request to reset the password for your account. If you made this request, please click the button below to choose a new password.
        </mj-text>
      </mj-column>
      
      <!-- Call to Action -->
      <mj-column width="100%">
         <mj-button align="left" href="{{reset_password_url}}" background-color="#2563eb" color="#ffffff" font-weight="bold" border-radius="6px" height="45px">
          Reset Password
        </mj-button>
      </mj-column>

      <mj-column width="100%">
        <mj-text font-size="14px" color="#64748b" padding-top="30px">
          If you didn't request a password reset, you can safely ignore this email. Your password will not change.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="20px" background-color="#f1f5f9">
      <mj-column>
        <mj-text align="center" color="#666666" font-size="12px">
          Need help? <a href="{{support_url}}" style="color: #2563eb; text-decoration: none;">Contact Support</a>
        </mj-text>
        <mj-text align="center" color="#666666" font-size="12px" padding-top="10px">
          © 2026 YouthSports Team Hub. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
