<mjml>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
      .footer-text {
        color: #64748b !important;
        font-size: 12px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-include path="partials/header.mjml" />

    {{#if featured_image_url}}
    <mj-section padding="24px 20px">
      <mj-column>
        <mj-image src="{{featured_image_url}}" alt="Featured" width="600px" border-radius="8px" />
      </mj-column>
    </mj-section>
    {{/if}}

    <mj-section padding="40px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          {{featured_title}}
        </mj-text>
        <mj-text padding-bottom="24px">
          {{featured_excerpt}}
        </mj-text>
        <mj-button css-class="button" href="{{featured_url}}" padding="16px 24px">
          Read More
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px" background-color="#f1f5f9">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          Latest Updates
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#1e293b" padding-bottom="8px">
          1. {{update_1_title}}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{update_1_description}}
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#1e293b" padding-bottom="8px">
          2. {{update_2_title}}
        </mj-text>
        <mj-text padding-bottom="16px">
          {{update_2_description}}
        </mj-text>
        <mj-text font-size="16px" font-weight="bold" color="#1e293b" padding-bottom="8px">
          3. {{update_3_title}}
        </mj-text>
        <mj-text padding-bottom="24px">
          {{update_3_description}}
        </mj-text>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          {{promo_title}}
        </mj-text>
        <mj-button css-class="button" href="{{promo_url}}" padding="16px 24px">
          {{promo_button_text}}
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
