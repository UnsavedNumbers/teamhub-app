<mjml>
  <mj-head>
    <mj-title>You're invited to join the staff!</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
      .footer-text {
        color: #64748b !important;
        font-size: 12px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-include path="partials/header.mjml" />

    <mj-section padding="40px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          Hey {{recipient_firstname}}!
        </mj-text>
        <mj-text padding-bottom="16px">
          {{sender_name}} ({{sender_email}}) wants you to join the staff at {{organization_name}}!
        </mj-text>
        <mj-text padding-bottom="16px">
          As a staff member, you'll be able to manage rosters, view schedules, and communicate with the team.
        </mj-text>
        <mj-text padding-bottom="24px">
          It's free to join and takes less than a minute.
        </mj-text>
        <mj-button css-class="button" href="{{join_url}}" padding="16px 24px">
          Join Staff
        </mj-button>
        <mj-text padding-top="24px">
          Cheers,<br>
          {{sender_name}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
