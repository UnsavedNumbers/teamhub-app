<mjml>
  <mj-head>
    <mj-title>Your photo was not approved</mj-title>
    <mj-preview>Your photo was not approved for the gallery</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button {
        background-color: #2563eb !important;
        color: #ffffff !important;
        padding: 12px 24px !important;
        text-decoration: none !important;
        border-radius: 6px !important;
        display: inline-block !important;
        font-weight: 600 !important;
      }
      .footer-text {
        color: #64748b !important;
        font-size: 12px !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-include path="partials/header.mjml" />

    <mj-section padding="40px 20px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#1e293b" padding-bottom="16px">
          Photo not approved
        </mj-text>
        <mj-text padding-bottom="16px">
          Hi {{recipient_name}},
        </mj-text>
        <mj-text padding-bottom="24px">
          Your photo was not approved for <strong>{{gallery_name}}</strong>. Please review the team's media guidelines and try again if you'd like to share photos.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px" background-color="#fef2f2" border-radius="8px" border="1px solid #fecaca">
      <mj-column>
        <mj-text font-size="14px" color="#991b1b" padding-bottom="8px">
          If you have questions about what content is allowed, contact your coach or organization administrator.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 20px">
      <mj-column>
        <mj-button css-class="button" href="{{url}}" padding="16px 24px">
          View gallery
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="partials/footer.mjml" />
  </mj-body>
</mjml>
