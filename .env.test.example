# ─── RLS Contract Test Environment Variables ───
# Copy to .env.test and fill in values from the Supabase TEST project dashboard.
#
# REQUIRED
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# OPTIONAL
# Storage bucket to test (defaults to public-media)
SUPABASE_TEST_STORAGE_BUCKET=public-media

# Password shared by all pre-created test users (see test_users.md)
CONTRACT_TEST_PASSWORD=TestPassword123!
